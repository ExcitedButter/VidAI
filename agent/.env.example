# --- Video generation provider (pick one) ---

# Option A: seevio.ai aggregator (Seedance 2.5 via https://api.seevio.ai)
# Key from https://seevio.ai/dashboard/user/api-keys ("sk_live_..."). The client
# auto-selects the seevio task API when the base URL contains "seevio".
ARK_API_KEY=
VIDAI_SEEDANCE_MODEL=seedance-2-5
VIDAI_SEEDANCE_BASE_URL=https://api.seevio.ai

# Option B: Volcano Engine Ark / BytePlus ModelArk (first-party Seedance)
# ARK_API_KEY=
# VIDAI_SEEDANCE_MODEL=doubao-seedance-2-5-pro
# VIDAI_SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# --- Planner / vision LLM: runs the structured-JSON modules + the Video QC judge ---

# Option A: Claude (any VIDAI_LLM_MODEL starting with "claude" routes to the native API)
VIDAI_LLM_MODEL=claude-opus-5
VIDAI_LLM_API_KEY=

# Option B: OpenAI GPT-6 Astra (reasoning model; $10 / $50 per MTok in/out, image input ok)
# VIDAI_LLM_BASE_URL=https://api.openai.com/v1
# VIDAI_LLM_MODEL=gpt-6-astra
# VIDAI_LLM_API_KEY=
# VIDAI_REASONING_EFFORT=low        # low|medium|high|xhigh|max; thinking tokens bill as output
# Option C: any other OpenAI-compatible /chat/completions endpoint with vision (gpt-4o, doubao, Qwen-VL)
# Vision model for Video QC; defaults to VIDAI_LLM_MODEL.
VIDAI_VLM_MODEL=

# --- Creative defaults (PRD §16 generationSettings) ---
VIDAI_MODE=guided            # guided | auto
VIDAI_DURATION=15            # 15 | 30
VIDAI_ASPECT=9:16
VIDAI_RESOLUTION=720p
VIDAI_MAX_SHOT_SEC=8         # stable clip length of the video model
VIDAI_WPM=150                # speaking rate used for duration estimates
VIDAI_MAX_SCRIPT_REPAIRS=2
VIDAI_MAX_VIDEO_REPAIRS=2
# VIDAI_CHARACTER_LIBRARY=/path/to/character_library.json

# --- Runtime ---
VIDAI_DATA_DIR=
# VIDAI_MOCK=1               # offline run with canned LLM replies + ffmpeg "Seedance"
